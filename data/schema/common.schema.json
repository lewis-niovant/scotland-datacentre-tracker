{
  "$id": "common.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared definitions",
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src-[a-z0-9-]+$",
      "description": "Reference to an entry in data/sources/sources.json"
    },
    "sourceIds": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/sourceId" },
      "minItems": 1
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "uncertaintyState": {
      "type": "string",
      "enum": [
        "confirmed",
        "reported",
        "developer_stated",
        "modelled",
        "inferred",
        "estimated",
        "disputed",
        "unknown",
        "not_disclosed",
        "superseded",
        "awaiting_verification"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "operating",
        "under_construction",
        "consented",
        "pending",
        "pre_application",
        "screening",
        "scoping",
        "announced",
        "strategic_opportunity",
        "grid_record_only",
        "refused",
        "appealed",
        "withdrawn",
        "lapsed",
        "paused",
        "superseded",
        "unknown"
      ]
    },
    "maturityLevel": {
      "type": "string",
      "enum": ["M0", "M1", "M2", "M3", "M4", "M5"],
      "description": "M0 concept/marketed, M1 early development, M2 formal application, M3 consented & progressing, M4 under construction, M5 operational"
    },
    "maturityFlag": {
      "type": "string",
      "enum": ["refused", "withdrawn", "lapsed", "appealed", "paused", "superseded"]
    },
    "projectType": {
      "type": "string",
      "enum": ["hyperscale", "colocation", "enterprise", "edge", "research_hpc", "public_sector", "telecoms", "unknown"]
    },
    "quantityClaim": {
      "type": "object",
      "description": "A sourced numeric claim; conflicting claims coexist as separate entries",
      "required": ["value", "state", "source_ids"],
      "properties": {
        "value": { "type": ["number", "null"] },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string" },
        "state": { "$ref": "common.schema.json#/$defs/uncertaintyState" },
        "claimant": { "type": "string" },
        "applicable_date": { "$ref": "common.schema.json#/$defs/isoDate" },
        "phase": { "type": "string" },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "preferred": { "type": "boolean", "description": "Current preferred interpretation" },
        "preferred_rationale": { "type": "string" },
        "notes": { "type": "string" },
        "source_ids": { "$ref": "common.schema.json#/$defs/sourceIds" }
      },
      "additionalProperties": false
    }
  }
}
